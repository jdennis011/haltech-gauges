{
  "schema": 1,
  "name": "Temps and oil",
  "theme": "white",
  "faces": [
    {
      "name": "Temps",
      "widgets": [
        { "type": "bar", "channel": "coolant_temp", "min": 40, "max": 130, "style": "vertical",
          "x": 150, "y": 210, "w": 36, "h": 240, "segments": 18,
          "zones": [ { "from": 105, "to": 130, "color": "alert" } ] },
        { "type": "bar", "channel": "oil_temp", "min": 40, "max": 150, "style": "vertical",
          "x": 316, "y": 210, "w": 36, "h": 240, "segments": 18,
          "zones": [ { "from": 125, "to": 150, "color": "alert" } ] },
        { "type": "number", "channel": "coolant_temp", "x": 150, "y": 365, "size": 40, "unitSize": 16, "unitPos": "right" },
        { "type": "number", "channel": "oil_temp", "x": 316, "y": 365, "size": 40, "unitSize": 16, "unitPos": "right" },
        { "type": "label", "text": "WATER", "x": 150, "y": 70, "size": 18, "color": "dim" },
        { "type": "label", "text": "OIL", "x": 316, "y": 70, "size": 18, "color": "dim" },
        { "type": "light", "channel": "oil_pressure_light", "y": 420, "r": 9, "text": "OIL" }
      ]
    },
    {
      "name": "Oil pressure",
      "widgets": [
        { "type": "dial", "channel": "oil_pressure", "unit": "psi", "min": 0, "max": 100, "major": 10,
          "minor": 2, "labelFont": "condensed",
          "zones": [ { "from": 0, "to": 15, "color": "alert" } ] },
        { "type": "number", "channel": "oil_pressure", "unit": "psi", "y": 320, "font": "digital",
          "size": 56, "warn": { "below": 15, "flash": true } },
        { "type": "label", "text": "OIL PRESSURE", "y": 150, "size": 20, "color": "dim" }
      ]
    }
  ]
}
