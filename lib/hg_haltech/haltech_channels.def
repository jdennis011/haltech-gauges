HG_U16(generic_sensor_9,        "Generic Sensor 9",           0x3E9, 0, 1.0f,   0.0f,    Raw)
HG_U16(generic_sensor_10,       "Generic Sensor 10",          0x3E9, 2, 1.0f,   0.0f,    Raw)
HG_U16(target_lambda,           "Target Lambda",              0x3E9, 4, 0.001f, 0.0f,    Lambda)
HG_BIT(nitrous_stage_1_output,  "Nitrous Stage 1 Output",     0x3E9, 6, 7)
HG_BIT(nitrous_stage_2_output,  "Nitrous Stage 2 Output",     0x3E9, 6, 6)
HG_BIT(nitrous_stage_3_output,  "Nitrous Stage 3 Output",     0x3E9, 6, 5)
HG_BIT(nitrous_stage_4_output,  "Nitrous Stage 4 Output",     0x3E9, 6, 4)
HG_BIT(nitrous_stage_5_output,  "Nitrous Stage 5 Output",     0x3E9, 6, 3)
HG_BIT(nitrous_stage_6_output,  "Nitrous Stage 6 Output",     0x3E9, 6, 2)
HG_BIT(water_injection_output,  "Water Injection Output",     0x3E9, 6, 1)
HG_S8 (torque_mgmt_knob,        "Torque Management Knob",     0x3E9, 7, 1.0f,   0.0f,    Raw)

HG_FRAME(0x3EA, 50)
HG_U16(gearbox_line_pressure,   "Gearbox Line Pressure",      0x3EA, 0, 0.1f,   -101.3f, Kpa)
HG_U16(inj_stage3_duty,         "Injection Stage 3 Duty",     0x3EA, 2, 0.1f,   0.0f,    Percent)
