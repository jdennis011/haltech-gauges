// Haltech ECU Broadcast CAN Protocol, document version 2.0 (08/2025).
// Source: docs/ref/haltech-ecu-broadcast-can-protocol-v2.0.pdf
//
// Include with the HG_* macros defined. Entries must stay grouped by CAN ID.
//
//   HG_FRAME(can_id, rate_hz)
//   HG_U16 / HG_S16 / HG_U8 / HG_S8 / HG_U32 / HG_S32
//          (name, label, can_id, byte, scale, offset, unit)      value = raw * scale + offset
//   HG_U16E / HG_S16E   same, but raw 0 means "sensor error"
//   HG_BIT (name, label, can_id, byte, bit)                      bit 7 = MSB of the byte
//   HG_BITS(name, label, can_id, byte, bit_hi, width, unit)      unsigned field, MSB at byte:bit_hi
//
// Conventions:
//   - Temperatures are sent as Kelvin x10 and stored as Celsius. Haltech's own
//     conversion uses 273.1 (raw 2731 = 0 C), so that offset is used here.
//   - Pressures whose formula in the document includes "- 101.3" are gauge kPa.
//     Manifold and barometric pressure are absolute.
//   - Target boost, pre-intercooler boost and exhaust manifold pressure are
//     listed as plain "kPa" with no offset. They are treated as absolute per the
//     document's blanket statement; confirm against NSP with the engine off.
//   - Brake pressures really are "x - 101.3" with no /10 in the document.

HG_FRAME(0x360, 50)
HG_U16(rpm,                     "RPM",                        0x360, 0, 1.0f,   0.0f,    Rpm)
HG_U16(manifold_pressure,       "Manifold Pressure",          0x360, 2, 0.1f,   0.0f,    KpaAbs)
HG_U16(throttle_position,       "Throttle Position",          0x360, 4, 0.1f,   0.0f,    Percent)
HG_U16(coolant_pressure,        "Coolant Pressure",           0x360, 6, 0.1f,   -101.3f, Kpa)

HG_FRAME(0x361, 50)
HG_U16(fuel_pressure,           "Fuel Pressure",              0x361, 0, 0.1f,   -101.3f, Kpa)
HG_U16(oil_pressure,            "Oil Pressure",               0x361, 2, 0.1f,   -101.3f, Kpa)
HG_U16(engine_demand,           "Engine Demand",              0x361, 4, 0.1f,   0.0f,    Percent)
HG_U16(wastegate_pressure,      "Wastegate Pressure",         0x361, 6, 0.1f,   -101.3f, Kpa)

HG_FRAME(0x362, 50)
HG_U16(inj_stage1_duty,         "Injection Stage 1 Duty",     0x362, 0, 0.1f,   0.0f,    Percent)
HG_U16(inj_stage2_duty,         "Injection Stage 2 Duty",     0x362, 2, 0.1f,   0.0f,    Percent)
HG_S16(ignition_angle,          "Ignition Angle",             0x362, 4, 0.1f,   0.0f,    Degrees)

HG_FRAME(0x363, 20)
HG_S16(wheel_slip,              "Wheel Slip",                 0x363, 0, 0.1f,   0.0f,    Kmh)
HG_S16(wheel_diff,              "Wheel Diff",                 0x363, 2, 0.1f,   0.0f,    Kmh)
HG_U16(launch_end_rpm,          "Launch Control End RPM",     0x363, 6, 1.0f,   0.0f,    Rpm)

HG_FRAME(0x364, 50)
HG_U16(inj_stage1_time,         "Injection Stage 1 Time",     0x364, 0, 0.001f, 0.0f,    Millisec)
HG_U16(inj_stage2_time,         "Injection Stage 2 Time",     0x364, 2, 0.001f, 0.0f,    Millisec)
HG_U16(inj_stage3_time,         "Injection Stage 3 Time",     0x364, 4, 0.001f, 0.0f,    Millisec)
HG_U16(inj_stage4_time,         "Injection Stage 4 Time",     0x364, 6, 0.001f, 0.0f,    Millisec)

HG_FRAME(0x368, 20)
HG_U16(wideband_1,              "Wideband 1",                 0x368, 0, 0.001f, 0.0f,    Lambda)
HG_U16(wideband_2,              "Wideband 2",                 0x368, 2, 0.001f, 0.0f,    Lambda)
HG_U16(wideband_3,              "Wideband 3",                 0x368, 4, 0.001f, 0.0f,    Lambda)
HG_U16(wideband_4,              "Wideband 4",                 0x368, 6, 0.001f, 0.0f,    Lambda)

HG_FRAME(0x369, 20)
HG_U16(trigger_error_count,     "Trigger Error Count",        0x369, 0, 1.0f,   0.0f,    Raw)
HG_U16(trigger_counter,         "Trigger Counter",            0x369, 2, 1.0f,   0.0f,    Raw)
HG_U16(trigger_sync_level,      "Trigger Sync Level",         0x369, 6, 1.0f,   0.0f,    Raw)

HG_FRAME(0x36A, 20)
HG_U16(knock_level_1,           "Knock Level 1",              0x36A, 0, 0.01f,  0.0f,    Decibel)
HG_U16(knock_level_2,           "Knock Level 2",              0x36A, 2, 0.01f,  0.0f,    Decibel)

HG_FRAME(0x36B, 20)
HG_U16(brake_pressure_front,    "Brake Pressure Front",       0x36B, 0, 1.0f,   -101.3f, Kpa)
HG_U16(nos_pressure_1,          "NOS Pressure 1",             0x36B, 2, 0.22f,  -101.3f, Kpa)
HG_U16(turbo_speed_1,           "Turbo Speed 1",              0x36B, 4, 10.0f,  0.0f,    Rpm)
HG_S16(lateral_g,               "Lateral G",                  0x36B, 6, 0.1f,   0.0f,    Mps2)

HG_FRAME(0x36C, 20)
HG_U16(wheel_speed_fl,          "Wheel Speed Front Left",     0x36C, 0, 0.1f,   0.0f,    Kmh)
HG_U16(wheel_speed_fr,          "Wheel Speed Front Right",    0x36C, 2, 0.1f,   0.0f,    Kmh)
HG_U16(wheel_speed_rl,          "Wheel Speed Rear Left",      0x36C, 4, 0.1f,   0.0f,    Kmh)
HG_U16(wheel_speed_rr,          "Wheel Speed Rear Right",     0x36C, 6, 0.1f,   0.0f,    Kmh)

HG_FRAME(0x36D, 20)
HG_S16(exhaust_cam_angle_1,     "Exhaust Cam Angle 1",        0x36D, 4, 0.1f,   0.0f,    Degrees)
HG_S16(exhaust_cam_angle_2,     "Exhaust Cam Angle 2",        0x36D, 6, 0.1f,   0.0f,    Degrees)

HG_FRAME(0x36E, 20)
HG_U16(engine_limiting_active,  "Engine Limiting Active",     0x36E, 0, 1.0f,   0.0f,    Bool)
HG_S16(launch_ign_retard,       "Launch Ignition Retard",     0x36E, 2, 0.1f,   0.0f,    Degrees)
HG_S16(launch_fuel_enrich,      "Launch Fuel Enrich",         0x36E, 4, 0.1f,   0.0f,    Percent)
HG_S16(longitudinal_g,          "Longitudinal G",             0x36E, 6, 0.1f,   0.0f,    Mps2)

HG_FRAME(0x36F, 20)
HG_U16(generic_output_1_duty,   "Generic Output 1 Duty",      0x36F, 0, 0.1f,   0.0f,    Percent)
HG_U16(boost_control_output,    "Boost Control Output",       0x36F, 2, 0.1f,   0.0f,    Percent)

// 0x370 bytes 2-3 (combined gear) duplicate the gear channels in 0x470 and are not decoded.
HG_FRAME(0x370, 20)
HG_U16(vehicle_speed,           "Vehicle Speed",              0x370, 0, 0.1f,   0.0f,    Kmh)
HG_S16(intake_cam_angle_1,      "Intake Cam Angle 1",         0x370, 4, 0.1f,   0.0f,    Degrees)
HG_S16(intake_cam_angle_2,      "Intake Cam Angle 2",         0x370, 6, 0.1f,   0.0f,    Degrees)

HG_FRAME(0x371, 10)
HG_U16(fuel_flow,               "Fuel Flow",                  0x371, 0, 1.0f,   0.0f,    CcPerMin)
HG_U16(fuel_flow_return,        "Fuel Flow Return",           0x371, 2, 1.0f,   0.0f,    CcPerMin)

HG_FRAME(0x372, 10)
HG_U16(battery_voltage,         "Battery Voltage",            0x372, 0, 0.1f,   0.0f,    Volts)
HG_U16(target_boost,            "Target Boost",               0x372, 4, 0.1f,   0.0f,    KpaAbs)
HG_U16(barometric_pressure,     "Barometric Pressure",        0x372, 6, 0.1f,   0.0f,    KpaAbs)

HG_FRAME(0x373, 10)
HG_U16(egt_1,                   "EGT 1",                      0x373, 0, 0.1f,   -273.1f, Celsius)
HG_U16(egt_2,                   "EGT 2",                      0x373, 2, 0.1f,   -273.1f, Celsius)
HG_U16(egt_3,                   "EGT 3",                      0x373, 4, 0.1f,   -273.1f, Celsius)
HG_U16(egt_4,                   "EGT 4",                      0x373, 6, 0.1f,   -273.1f, Celsius)

HG_FRAME(0x374, 10)
HG_U16(egt_5,                   "EGT 5",                      0x374, 0, 0.1f,   -273.1f, Celsius)
HG_U16(egt_6,                   "EGT 6",                      0x374, 2, 0.1f,   -273.1f, Celsius)
HG_U16(egt_7,                   "EGT 7",                      0x374, 4, 0.1f,   -273.1f, Celsius)
HG_U16(egt_8,                   "EGT 8",                      0x374, 6, 0.1f,   -273.1f, Celsius)

HG_FRAME(0x375, 10)
HG_U16(egt_9,                   "EGT 9",                      0x375, 0, 0.1f,   -273.1f, Celsius)
HG_U16(egt_10,                  "EGT 10",                     0x375, 2, 0.1f,   -273.1f, Celsius)
HG_U16(egt_11,                  "EGT 11",                     0x375, 4, 0.1f,   -273.1f, Celsius)
HG_U16(egt_12,                  "EGT 12",                     0x375, 6, 0.1f,   -273.1f, Celsius)

HG_FRAME(0x376, 10)
HG_U16(ambient_air_temp,        "Ambient Air Temperature",    0x376, 0, 0.1f,   -273.1f, Celsius)
HG_S16(relative_humidity,       "Relative Humidity",          0x376, 2, 0.1f,   0.0f,    Percent)
HG_U16(specific_humidity,       "Specific Humidity",          0x376, 4, 100.0f, 0.0f,    Ppm)
HG_U16(absolute_humidity,       "Absolute Humidity",          0x376, 6, 0.1f,   0.0f,    GramPerM3)

HG_FRAME(0x377, 50)
HG_U16(boost_pre_intercooler,   "Boost Pre Intercooler",      0x377, 0, 0.1f,   0.0f,    KpaAbs)

HG_FRAME(0x380, 10)
HG_U16(generic_output_1_value,  "Generic Output 1 Value",     0x380, 0, 1.0f,   0.0f,    Raw)
HG_U16(generic_output_2_value,  "Generic Output 2 Value",     0x380, 2, 1.0f,   0.0f,    Raw)
HG_U16(generic_output_3_value,  "Generic Output 3 Value",     0x380, 4, 1.0f,   0.0f,    Raw)
HG_U16(generic_output_4_value,  "Generic Output 4 Value",     0x380, 6, 1.0f,   0.0f,    Raw)

HG_FRAME(0x3E0, 5)
HG_U16(coolant_temp,            "Coolant Temperature",        0x3E0, 0, 0.1f,   -273.1f, Celsius)
HG_U16(air_temp,                "Air Temperature",            0x3E0, 2, 0.1f,   -273.1f, Celsius)
HG_U16(fuel_temp,               "Fuel Temperature",           0x3E0, 4, 0.1f,   -273.1f, Celsius)
HG_U16(oil_temp,                "Oil Temperature",            0x3E0, 6, 0.1f,   -273.1f, Celsius)

HG_FRAME(0x3E1, 5)
HG_U16(gearbox_oil_temp,        "Gearbox Oil Temperature",    0x3E1, 0, 0.1f,   -273.1f, Celsius)
HG_U16(diff_oil_temp,           "Diff Oil Temperature",       0x3E1, 2, 0.1f,   -273.1f, Celsius)
HG_U16(fuel_composition,        "Fuel Composition (Ethanol)", 0x3E1, 4, 0.1f,   0.0f,    Percent)
HG_U16(air_temp_pre_intercooler, "Air Temp Pre Intercooler",  0x3E1, 6, 0.1f,   -273.1f, Celsius)

// 0x3E2 lists Fuel Level twice (bytes 0-1 and 6-7); only the first is decoded.
HG_FRAME(0x3E2, 5)
HG_U16(fuel_level,              "Fuel Level",                 0x3E2, 0, 0.1f,   0.0f,    Litres)
HG_S16(fuel_flow_estimated,     "Fuel Estimated Flow",        0x3E2, 2, 0.1f,   0.0f,    CcPerMin)
HG_U16(fuel_mileage_avg,        "Average Fuel Mileage",       0x3E2, 4, 0.1f,   0.0f,    KmPerLitre)

HG_FRAME(0x3E3, 5)
HG_S16(fuel_trim_st_bank1,      "Fuel Trim Short Term B1",    0x3E3, 0, 0.1f,   0.0f,    Percent)
HG_S16(fuel_trim_st_bank2,      "Fuel Trim Short Term B2",    0x3E3, 2, 0.1f,   0.0f,    Percent)
HG_S16(fuel_trim_lt_bank1,      "Fuel Trim Long Term B1",     0x3E3, 4, 0.1f,   0.0f,    Percent)
HG_S16(fuel_trim_lt_bank2,      "Fuel Trim Long Term B2",     0x3E3, 6, 0.1f,   0.0f,    Percent)

HG_FRAME(0x3E4, 5)
HG_BIT(neutral_switch,          "Neutral Switch",             0x3E4, 1, 7)
HG_BIT(reverse_switch,          "Reverse Switch",             0x3E4, 1, 6)
HG_BIT(gear_switch,             "Gear Switch",                0x3E4, 1, 5)
HG_BIT(decel_cut_active,        "Decel Cut Active",           0x3E4, 1, 4)
HG_BIT(transient_throttle_active, "Transient Throttle Active", 0x3E4, 1, 3)
HG_BIT(brake_pedal_switch,      "Brake Pedal Switch",         0x3E4, 1, 2)
HG_BIT(clutch_switch,           "Clutch Switch",              0x3E4, 1, 1)
HG_BIT(oil_pressure_light,      "Oil Pressure Light",         0x3E4, 1, 0)
HG_BIT(launch_control_active,   "Launch Control Active",      0x3E4, 2, 7)
HG_BIT(launch_control_switch,   "Launch Control Switch",      0x3E4, 2, 6)
HG_BIT(aux_rpm_limiter_active,  "Aux RPM Limiter Active",     0x3E4, 2, 5)
HG_BIT(brake_fluid_level_switch, "Brake Fluid Level Switch",  0x3E4, 2, 4)
HG_BIT(flat_shift_switch,       "Flat Shift Switch",          0x3E4, 2, 3)
HG_BIT(clutch_pressure_sensor,  "Clutch Pressure Sensor",     0x3E4, 2, 2)
HG_BIT(torque_reduction_active, "Torque Reduction Active",    0x3E4, 2, 1)
HG_BIT(traction_control_enabled, "Traction Control Enabled",  0x3E4, 3, 7)
HG_BIT(traction_control_active, "Traction Control Active",    0x3E4, 3, 6)
HG_BIT(aircon_request,          "Air Con Request",            0x3E4, 3, 5)
HG_BIT(aircon_output,           "Air Con Output",             0x3E4, 3, 4)
HG_BIT(thermofan_4,             "Thermo Fan 4",               0x3E4, 3, 3)
HG_BIT(thermofan_3,             "Thermo Fan 3",               0x3E4, 3, 2)
HG_BIT(thermofan_2,             "Thermo Fan 2",               0x3E4, 3, 1)
HG_BIT(thermofan_1,             "Thermo Fan 1",               0x3E4, 3, 0)
HG_S8 (rotary_trim_pot_1,       "Rotary Trim Pot 1",          0x3E4, 4, 1.0f,   0.0f,    Raw)
HG_S8 (rotary_trim_pot_2,       "Rotary Trim Pot 2",          0x3E4, 5, 1.0f,   0.0f,    Raw)
HG_S8 (rotary_trim_pot_3,       "Rotary Trim Pot 3",          0x3E4, 6, 1.0f,   0.0f,    Raw)
HG_BIT(check_engine_light,      "Check Engine Light",         0x3E4, 7, 7)
HG_BIT(battery_light,           "Battery Light",              0x3E4, 7, 6)
HG_BIT(hand_brake,              "Hand Brake",                 0x3E4, 7, 1)
HG_BIT(traction_control_light,  "Traction Control Light",     0x3E4, 7, 0)

HG_FRAME(0x3E5, 50)
HG_U8 (ignition_switch,         "Ignition Switch",            0x3E5, 0, 1.0f,   0.0f,    Bool)
HG_U8 (turbo_timer_remaining,   "Turbo Timer Remaining",      0x3E5, 1, 1.0f,   0.0f,    Seconds)
HG_U8 (turbo_timer_engine_remaining, "Turbo Timer Engine Remaining", 0x3E5, 2, 1.0f, 0.0f, Seconds)
HG_BIT(pit_limiter_error,       "Pit Limiter Error",          0x3E5, 3, 6)
HG_BIT(pit_limiter_active,      "Pit Limiter Active",         0x3E5, 3, 5)
HG_BIT(pit_limiter_switch,      "Pit Limiter Switch",         0x3E5, 3, 4)
