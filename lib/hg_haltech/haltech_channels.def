HG_BIT(abs_active,              "ABS Active",                 0x3E5, 3, 1)
HG_BIT(abs_armed,               "ABS Armed",                  0x3E5, 3, 0)
HG_S16(steering_angle,          "Steering Wheel Angle",       0x3E5, 4, 0.1f,   0.0f,    Degrees)
HG_U16(driveshaft_rpm,          "Driveshaft RPM",             0x3E5, 6, 1.0f,   0.0f,    Rpm)

HG_FRAME(0x3E6, 20)
HG_U16(nos_pressure_2,          "NOS Pressure 2",             0x3E6, 0, 0.22f,  -101.3f, Kpa)
HG_U16(nos_pressure_3,          "NOS Pressure 3",             0x3E6, 2, 0.22f,  -101.3f, Kpa)
HG_U16(nos_pressure_4,          "NOS Pressure 4",             0x3E6, 4, 0.22f,  -101.3f, Kpa)
HG_U16(turbo_speed_2,           "Turbo Speed 2",              0x3E6, 6, 10.0f,  0.0f,    Rpm)

// Generic sensors are sent raw; their scaling depends on how each one is set up in the ECU.
HG_FRAME(0x3E7, 20)
HG_U16(generic_sensor_1,        "Generic Sensor 1",           0x3E7, 0, 1.0f,   0.0f,    Raw)
HG_U16(generic_sensor_2,        "Generic Sensor 2",           0x3E7, 2, 1.0f,   0.0f,    Raw)
HG_U16(generic_sensor_3,        "Generic Sensor 3",           0x3E7, 4, 1.0f,   0.0f,    Raw)
