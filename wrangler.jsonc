{
  // Cloudflare Worker that serves the online copy of the page (see docs/designer-plan.md).
  // Build first (npm run build), which fills ./dist; then wrangler deploy.
  "name": "haltech-gauges",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  // The site's own name; Cloudflare makes the DNS records and certificates.
  "routes": [
    { "pattern": "oagauge.online", "custom_domain": true },
    { "pattern": "www.oagauge.online", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Per-user storage for configs, planned gauges, assignments and recordings.
  "kv_namespaces": [
    { "binding": "HG", "id": "f3c869bcd2f242be8ea686a3ab35fd7c" }
  ],
  "vars": {
    // The OAuth client ID from Google Cloud Console (APIs & Services > Credentials,
    // OAuth client ID, Web application, with this site's origins as authorised
    // JavaScript origins). Empty until set; the page then shows sign-in as not set up.
    "GOOGLE_CLIENT_ID": ""
  }
  // SESSION_SECRET is a Worker secret (wrangler secret put SESSION_SECRET), never in this file.
}
